        {
          "audience": "all",
          "basis": "your prompts",
          "command": "tensward analyse --project /p/lb --engine-arg 'speculative-config={\"method\": \"ngram\", \"num_speculative_tokens\": 4, \"prompt_lookup_max\": 4}'",
          "costs": "TPOT rises when answers do not copy the prompt, and at high concurrency; a slower start",
          "evidence": "moderate",
          "key": "ngram-speculation",
          "kind": "suggestion",
          "name": "ngram-speculation",
          "near": false,
          "quality_risk": false,
          "reason": "prompts are long (median 1523 words beyond what they share). N-gram speculation drafts tokens by copying spans of the prompt, so it only helps when answers quote or repeat their input; otherwise it costs a little - compare TPOT with and without it",
          "tier": "could_help"
        },
        {
          "audience": "all",
          "basis": "",
          "command": "tensward analyse --project /p/lb --engine-arg max-num-batched-tokens=4096",
          "costs": "TPOT p95 rises as larger chunks stall running decodes",
          "evidence": "moderate",
          "key": "raise-prefill-batch",
          "kind": "suggestion",
          "name": "raise-prefill-batch",
          "near": true,
          "quality_risk": false,
          "reason": "prompt work takes 55% of engine time with requests waiting, but steps are not full; a larger budget lets more prompt tokens into each step and can stall running decodes (TPOT p95) - measure TTFT and TPOT p95",
